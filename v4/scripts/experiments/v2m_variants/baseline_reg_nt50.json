      },
      "cd_aux": {
        "module": "v4.classes.heads.regression",
        "class":  "RegressionHead",
        "args":   { "dropout": 0.3, "target_key": "vf_md", "loss": "mse" }
      },
      "nt_head": {
        "module": "v4.classes.heads.regression",
        "class":  "RegressionHead",
        "args":   { "dropout": 0.3, "target_key": "vf_md", "loss": "mse" }
      },
      "hb_head": {
        "module": "v4.classes.heads.regression",
        "class":  "RegressionHead",
        "args":   { "dropout": 0.3, "target_key": "vf_md", "loss": "mse" }
      }
    }
  }
